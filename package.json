  "dependencies": {
    "astro": "^7.4.4",
    "pdfjs-dist": "6.4.299",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@etalab/decoupage-administratif": "^6.0.0",
    "@types/node": "^26.6.6",
    "7zip-min": "^3.0.1",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild": true
  }

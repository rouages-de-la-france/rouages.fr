    "valider": "tsx scripts/valider.ts",
    "fraicheur": "tsx scripts/valider.ts --fraicheur",
    "verifier-types": "astro check",
    "territoires": "tsx scripts/ingerer-territoires.ts",
    "verifier-recherche": "tsx scripts/verifier-recherche.ts",
    "verifier-journal": "tsx scripts/verifier-journal.ts",
    "verifier-rattachement": "tsx scripts/verifier-rattachement.ts",
    "verifier-marches": "tsx scripts/verifier-marches.ts",
    "verifier-liens": "tsx scripts/verifier-liens.ts",
    "verifier-ressources": "tsx scripts/verifier-ressources.ts",
    "verifier-reseau": "tsx scripts/verifier-reseau.ts",
    "verifier-particuliers": "tsx scripts/verifier-particuliers.ts",
    "verifier-themes": "tsx scripts/verifier-themes.ts",
    "verifier-horaires": "tsx scripts/verifier-horaires.ts",
    "verifier-autorisations": "tsx scripts/verifier-autorisations.ts",
    "verifier-parcelle": "tsx scripts/verifier-parcelle.ts",
    "relecture-parcelle": "tsx scripts/relecture-parcelle.ts",
    "relecture-autorisations": "tsx scripts/relecture-autorisations.ts",
    "verifier-accessibilite": "tsx scripts/verifier-accessibilite.ts",
    "verifier-geo": "tsx scripts/verifier-geo.ts",
    "verifier-veille-aides": "tsx scripts/verifier-veille-aides.ts",
    "relire": "tsx scripts/relire.ts",
    "veille": "tsx scripts/veille.ts",
    "publier": "tsx scripts/valider.ts --publication && npm run verifier-recherche && npm run verifier-journal && npm run verifier-reseau && astro build"

---
/**
 * L'indice de position sociale des écoles et des collèges de la commune,
 * comparé à celui du département et de la France que publie le ministère,
 * public et privé à part : les deux secteurs ont des références très
 * différentes, et comparer une école privée à la moyenne de l'ensemble ne
 * dirait rien.
 */
import type { Ecoles } from '../../modele/fiche-vie.ts';
import { nomEcole } from '../../vues/nom-ecole.ts';

interface Props {
  e: Ecoles;
  depNom: string;
}
const { e, depNom } = Astro.props;
const n = (v: number | null | undefined) => (v == null ? '—' : v.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }));
const ref = (type: 'école' | 'collège', secteur: 'public' | 'privé') => {
  const r = e.references?.[type];
  const k = secteur === 'public' ? 0 : 1;
  return { dep: r?.dep[k] ?? null, france: r?.france[k] ?? null };
};
// Les noms de l'annuaire, rendus lisibles (voir `src/vues/nom-ecole.ts`) ; le
// secteur n'est ajouté que si le nom ne le dit pas déjà.
const nom = (x: string) => nomEcole(x);
const libelle = (x: { nom: string; secteur: string }) => {
  const n = nomEcole(x.nom);
  return /\b(publique?|privée?)\b/i.test(n) ? n : `${n} (${x.secteur})`;
};
const rentrees = [...new Set(e.etablissements.map((x) => e.rentrees[x.type]))];
const entier = (v: number) => Math.round(v).toLocaleString('fr-FR');
// La valeur ajoutée, signée ; « non calculée » sous quarante candidats, la règle de la DEPP.
const va = (v: number | null, candidats: number | null, unite: string) =>
  v != null ? `${v > 0 ? '+' : v < 0 ? '−' : ''}${n(Math.abs(v)).replace(',0', '')}${unite}` : candidats != null && candidats < 40 ? 'non calculée' : 'non publiée';
// Au-delà de vingt établissements — Paris en compte près de huit cents —, un
// tableau pèserait plus que tout le reste de la page : on donne l'étendue.
const LIMITE = 20;
const long = e.etablissements.length > LIMITE;
const etendue = (type: 'école' | 'collège') => {
  const x = e.etablissements.filter((y) => y.type === type).sort((a, b) => a.ips - b.ips);
  if (x.length === 0) return null;
  const pluriel = type === 'école' ? 'écoles' : 'collèges';
  return x.length === 1
    ? `un${type === 'école' ? 'e' : ''} ${type}, d’indice ${n(x[0].ips)}`
    : `${x.length.toLocaleString('fr-FR')} ${pluriel}, d’un indice de ${n(x[0].ips)} (${nom(x[0].nom)}) à ${n(x.at(-1)!.ips)} (${nom(x.at(-1)!.nom)})`;
};
---
{long && (
  <p class="mesure">
    {`À la rentrée ${rentrees.join(' et ')} : ${[etendue('école'), etendue('collège')].filter(Boolean).join(' ; ')}. ` +
      `Pour comparer : ${depNom}, ${n(ref('école', 'public').dep)} dans les écoles publiques et ${n(ref('école', 'privé').dep)} dans les privées ; ` +
      `France, ${n(ref('école', 'public').france)} et ${n(ref('école', 'privé').france)}.`}
  </p>
)}
{!long && (
<div class="cpt-defile" tabindex="0" role="region" aria-label="Les écoles — le tableau défile sur les petits écrans">
<table class="cpt-tableau">
  <caption>{`Indice de position sociale, rentrée ${rentrees.join(' et ')}`}</caption>
  <thead>
    <tr>
      <th scope="col">Établissement</th>
      <th scope="col">IPS</th>
      <th scope="col">{depNom}</th>
      <th scope="col">France</th>
    </tr>
  </thead>
  <tbody>
    {e.etablissements.map((x) => (
      <tr>
        <th scope="row">{libelle(x)}</th>
        <td>{n(x.ips)}</td>
        <td>{n(ref(x.type, x.secteur).dep)}</td>
        <td>{n(ref(x.type, x.secteur).france)}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>
)}
{e.brevet && e.brevet.colleges.length > 0 && (
  <div class="cpt-defile" tabindex="0" role="region" aria-label="Le brevet des collèges — le tableau défile sur les petits écrans">
  <table class="cpt-tableau">
    <caption>{`Le brevet, session ${e.brevet.session}, série générale`}</caption>
    <thead>
      <tr>
        <th scope="col">Collège</th>
        <th scope="col">Candidats</th>
        <th scope="col">Réussite</th>
        <th scope="col">Sa valeur ajoutée</th>
        <th scope="col">Note à l’écrit</th>
        <th scope="col">Sa valeur ajoutée</th>
        <th scope="col">De la 6<sup>e</sup> à la 3<sup>e</sup></th>
      </tr>
    </thead>
    <tbody>
      {e.brevet.colleges.map((x) => (
        <tr>
          <th scope="row">{libelle(x)}</th>
          <td>{x.candidats ?? '—'}</td>
          <td>{x.taux == null ? '—' : `${entier(x.taux)} %`}</td>
          <td>{va(x.vaTaux, x.candidats, ' points')}</td>
          <td>{x.note == null ? '—' : `${n(x.note)} / 20`}</td>
          <td>{va(x.vaNote, x.candidats, '')}</td>
          <td>{x.acces == null ? '—' : `${entier(x.acces)} %`}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
)}
{e.brevet && e.brevet.colleges.length > 0 && (
  <p class="p-strate">
    {'La valeur ajoutée est l’écart entre le résultat constaté et celui qu’on attendait des élèves accueillis — leur âge, leur sexe, leur origine sociale, leur niveau à l’entrée en sixième, et la composition du collège —, d’après un modèle de la DEPP : positive, le collège fait mieux que prévu ; négative, moins bien. '}
    {'Elle n’est pas calculée sous quarante candidats en série générale, ni quand les scores aux évaluations de sixième ou la profession des parents manquent pour plus d’un quart d’entre eux. Le taux d’accès dit la probabilité, pour un élève de sixième, d’arriver en troisième en restant dans le collège, quel que soit le nombre d’années.'}
  </p>
)}
<p class="p-strate">
  {'L’indice résume les conditions sociales et culturelles des familles des élèves, d’après la profession de leurs parents surtout : ' +
    'plus il est haut, plus les élèves viennent de milieux favorisés. Il décrit qui fréquente l’établissement, pas ce qu’on y enseigne. ' +
    'Le département et la France sont ceux du même secteur, public ou privé, et du même type d’établissement. Les enseignants et les ouvertures de classes relèvent du '}
  <a href="/n/rectorat">rectorat</a>
  {' ; les murs d’une école, de la commune, ceux d’un collège, du '}<a href="/n/colleges">département</a>{'.'}
</p>
<p class="p-source-territoire">
  {`D’après les indices de position sociale publiés par le ministère de l’Éducation nationale (${e.maj}). ` +
    (e.brevet ? `Le brevet : indicateurs de valeur ajoutée des collèges de la DEPP, session ${e.brevet.session}.` : '')}
</p>

---
/**
 * Les programmes de l'ANCT dont la commune bénéficie, et la zone de montagne.
 * Ce sont des décisions de l'État sur le territoire : elles ouvrent des
 * crédits, de l'ingénierie, ou appliquent une loi — voir
 * `scripts/zonages-emettre.ts`.
 */
import type { Zonages } from '../../modele/fiche-vie.ts';
import { lienDispositif } from '../../modele/dispositifs.ts';
import Glose from '../Glose.astro';

interface Props {
  z: Zonages;
}
const { z } = Astro.props;
const NOMS: Record<string, string> = {
  pvd: 'Petites villes de demain',
  acv: 'Action cœur de ville',
  va: 'Villages d’avenir',
  ami: 'Avenir montagnes ingénierie',
  amm: 'Avenir montagnes mobilités',
  cite: 'une cité éducative',
  cde: 'une cité de l’emploi',
  fabp: 'une Fabrique prospective',
  habinclus: 'l’appel à manifestation d’intérêt « Habitat inclusif »',
};
const programmes = z.programmes.map((p) => NOMS[p]).filter(Boolean);
const montagne = lienDispositif('montagne');
const frr = lienDispositif('frr');
const leader = lienDispositif('leader');
const lien = (cle: string, texte: string) => ({ href: lienDispositif(cle), texte });
const ti = lien('ti', 'Territoire d’industrie');
const crte = lien('crte', 'contrat pour la réussite de la transition écologique');
const qpv = lien('qpv', 'de la politique de la ville');
const tlv = lien('tlv', z.tendue === 'touristique et tendue' ? 'zone touristique et tendue' : 'zone tendue');
const FRR: Record<string, string> = {
  plus: ' « plus », le niveau renforcé, réservé au quart des communes classées, rurales, dont l’intercommunalité ou le bassin de vie a connu de 2009 à 2020 l’évolution la plus défavorable du revenu, de la population et de l’emploi : les exonérations d’impôts des entreprises qui s’y créent ou s’y reprennent y valent pour plus d’entreprises et d’opérations qu’au niveau « socle ».',
  socle: ' « socle » : une entreprise qui s’y crée ou s’y reprend d’ici le 31 décembre 2029 peut être exonérée d’impôt sur les bénéfices, et de cotisation foncière et de taxe foncière si la commune et l’intercommunalité l’ont délibéré ; les fractions « bourg-centre » et « péréquation » de la dotation de solidarité rurale de la commune sont majorées.',
  beneficiaire: ' en tant que commune « bénéficiaire » : ancienne zone de revitalisation rurale non retenue par le nouveau classement, elle en garde les effets — mêmes exonérations, même majoration de la dotation de solidarité rurale — jusqu’au 31 décembre 2029.',
  'socle-partiel': ' pour une partie de son territoire seulement — celui d’une ancienne commune classée.',
  'beneficiaire-partiel': ' en tant que commune « bénéficiaire », pour une partie de son territoire seulement — celui d’une ancienne commune en zone de revitalisation rurale.',
};
const date = (d?: string) => (d ? d.split('-').reverse().join('/') : '');
---
<ul class="c-structures">
  {programmes.length > 0 ? (
    <li>
      {'Programmes de l’ANCT dont la commune bénéficie : '}
      {z.programmes
        .filter((p) => NOMS[p])
        .map((p, i, t) => (
          <>
            {lienDispositif(p) ? <a href={lienDispositif(p)!}>{NOMS[p]}</a> : <Glose texte={NOMS[p]} />}
            {i < t.length - 1 ? ', ' : '.'}
          </>
        ))}
    </li>
  ) : (
    <li><Glose texte="La commune ne figure dans aucun des programmes de commune de l’ANCT : ni Petites villes de demain, ni Action cœur de ville, ni Villages d’avenir." /></li>
  )}
  {z.territoireIndustrie && <li>{'Elle est dans le '}{ti.href ? <a href={ti.href}>{ti.texte}</a> : ti.texte}{` « ${z.territoireIndustrie} ».`}</li>}
  {z.crte && <li>{'Elle est couverte par le '}{crte.href ? <a href={crte.href}>{crte.texte}</a> : crte.texte}{` « ${z.crte} ».`}</li>}
  {z.abc && (
    <li>
      {lienDispositif('abc') ? <a href={lienDispositif('abc')!}>Zonage ABC</a> : 'Zonage ABC'}
      {` : zone ${z.abc}` +
        (z.abc === 'C'
          ? ', le reste du territoire, hors des zones où l’offre et la demande de logements sont en déséquilibre important.'
          : z.abc === 'B2'
            ? ', hors des zones où l’offre et la demande de logements sont en déséquilibre important.'
            : ', une des zones où l’offre et la demande de logements sont en déséquilibre important.') +
        ' Ce classement règle l’accès au prêt à taux zéro et aux aides à l’investissement locatif, et leurs plafonds.'}
    </li>
  )}
  {z.tendue && (
    <li>
      {z.tendue === 'non' ? 'Elle n’est pas en ' : 'Elle est classée en '}
      {tlv.href ? <a href={tlv.href}>{tlv.texte}</a> : tlv.texte}
      {z.tendue === 'non'
        ? ' : la taxe sur les logements vacants de l’État ne s’y applique pas ; la commune peut en revanche instituer, par délibération, une taxe d’habitation sur les logements vacants.'
        : ' : un logement vide depuis plus d’un an y est soumis à la taxe sur les logements vacants, et la commune peut majorer de 5 à 60 % la taxe d’habitation sur les résidences secondaires.'}
    </li>
  )}
  {z.quartiersPrioritaires.length > 0 && (
    <li>
      {z.quartiersPrioritaires.length === 1 ? 'Un quartier prioritaire ' : `${z.quartiersPrioritaires.length} quartiers prioritaires `}
      {qpv.href ? <a href={qpv.href}>{qpv.texte}</a> : qpv.texte}
      {` : ${z.quartiersPrioritaires.join(', ')}.`}
    </li>
  )}
  {z.leader && (
    <li>
      {z.leader.gal ? 'Elle fait partie d’un groupe d’action locale ' : z.leader.couvert ? 'Elle n’est dans aucun groupe d’action locale ' : 'Le site ne sait pas si elle fait partie d’un groupe d’action locale '}
      {leader ? <a href={leader}>LEADER</a> : 'LEADER'}
      {z.leader.gal
        ? ` : « ${z.leader.gal} », qui porte une stratégie locale de développement pour 2023-2027, financée par le fonds européen agricole pour le développement rural.`
        : z.leader.couvert
          ? ' pour 2023-2027, d’après le périmètre que publie sa Région.'
          : ` : aucune liste nationale n’est publiée, et le site n’a pas la liste des communes des groupes ${z.leader.region ? `de la région ${z.leader.region}` : 'de sa région'}.`}
    </li>
  )}
  {z.frr && (
    <li>
      {z.frr === 'non' ? 'Elle n’est pas en zone ' : 'Elle est en zone '}
      {frr ? <a href={frr}>France ruralités revitalisation</a> : 'France ruralités revitalisation'}
      {z.frr === 'non' ? ', qui remplace depuis 2024 les zones de revitalisation rurale.' : FRR[z.frr]}
    </li>
  )}
  {z.montagneUrbanisme && (
    <li>
      {z.montagneUrbanisme === 'oui' ? 'Elle est en ' : 'Elle n’est pas en '}
      {montagne ? <a href={montagne}>zone de montagne</a> : 'zone de montagne'}
      {z.montagneUrbanisme === 'oui'
        ? ' au sens de l’urbanisme : les règles d’urbanisme de la loi Montagne s’y appliquent, dont la construction en continuité des bourgs, villages et hameaux existants.'
        : ' au sens de l’urbanisme : les règles d’urbanisme propres à la montagne ne s’y appliquent pas.'}
    </li>
  )}
  <li>
    {z.montagne === 'oui'
      ? 'Elle est classée en zone agricole défavorisée de montagne : ses terres relèvent de la montagne pour les indemnités compensatoires de handicaps naturels, versées aux agriculteurs qui exploitent des surfaces en zone défavorisée.'
      : z.montagne === 'en partie'
        ? 'Elle est en partie en zone agricole défavorisée de montagne : une partie de ses terres relève de la montagne pour les indemnités compensatoires de handicaps naturels.'
        : 'Elle n’est pas en zone agricole défavorisée de montagne.'}
  </li>
</ul>
<p class="p-strate">
  <a href="/dispositif">Ce que sont ces programmes et zonages, et comment les lire</a>.
  <Glose texte={'Un programme de l’ANCT accompagne la commune ou son intercommunalité dans un projet — ingénierie, crédits, appui de l’État, selon le programme ; la liste ne dit rien des montants reçus. ' +
    'Un Territoire d’industrie et un contrat pour la réussite de la transition écologique se signent à l’échelle d’un groupement de communes, le plus souvent l’intercommunalité. ' +
    'Le zonage ABC classe les communes en cinq zones, de A bis à C, par tension décroissante du marché du logement ; A bis, A et B1 sont dites en déséquilibre important. ' +
    'Les quartiers prioritaires sont la géographie de la politique de la ville : ses crédits et ses dispositifs leur sont destinés. ' +
    'Les zones tendues sont fixées par décret, en dernier lieu celui du 22 décembre 2025 : depuis 2023, des communes touristiques où les résidences secondaires rendent le logement difficile d’accès s’ajoutent à celles des grandes agglomérations. La majoration de la taxe d’habitation se vote par délibération : la liste dit qu’elle est possible, pas qu’elle a été votée. Au 1er janvier 2027, la taxe sur les logements vacants et la taxe d’habitation sur les logements vacants seront fusionnées en une taxe sur la vacance des locaux d’habitation, perçue par le bloc communal : de plein droit en zone tendue, sur délibération ailleurs. ' +
    'La montagne a plusieurs délimitations officielles, qui ne coïncident pas : celle de l’urbanisme dit où s’appliquent les règles de construction de la loi Montagne ; celle des zones agricoles défavorisées dit quelles terres relèvent de la montagne pour les indemnités compensatoires de handicaps naturels versées aux agriculteurs. La liste agricole publiée date de 2017, reportée ici sur les communes actuelles.'} />
</p>
<p class="p-source-territoire">
  {`D’après les listes de communes des programmes de l’Agence nationale de la cohésion des territoires — Petites villes de demain (${date(z.dates.pvd)}), Action cœur de ville (${date(z.dates.acv)}), Villages d’avenir (${date(z.dates.va)}), Territoires d’industrie (${date(z.dates.ti)}), contrats pour la réussite de la transition écologique (${date(z.dates.crte)}), quartiers prioritaires (${date(z.dates.qpv)}) — et son tableau de croisement des dispositifs (${date(z.dates.croisement)}) ; le zonage ABC, d’après la liste du ministère chargé du logement (${date(z.dates.abc)}) ;${z.dates.tlv ? ` les zones tendues, d’après la liste des communes selon le zonage de la taxe sur les logements vacants du même ministère (${date(z.dates.tlv)}) ;` : ''} ${z.leader?.couvert ? ` LEADER, d’après les groupes d’action locale publiés par la Région (lus le ${date(z.leader.maj)}) ;` : ''}${z.dates.frr ? ` France ruralités revitalisation, d’après la liste des communes de la direction générale des collectivités locales (${date(z.dates.frr)}) ;` : ''}${z.dates.montagneUrbanisme ? ` la zone de montagne au sens de l’urbanisme, d’après l’Observatoire des territoires de l’ANCT (${date(z.dates.montagneUrbanisme)}) ;` : ''} la zone agricole défavorisée de montagne, d’après la liste des communes classées en zones défavorisées du ministère de l’Agriculture (${z.maj}).`}
</p>

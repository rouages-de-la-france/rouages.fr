---
import Base from '../layouts/Base.astro';
import Explorateur from '../composants/Explorateur.astro';
import { construireReseau } from '../modele/reseau.ts';

// Les acteurs publics seuls : les rouages de l'économie ont leur carte, /economie.
const reseau = construireReseau(undefined, { vue: 'public' });
---

<Base
  titre="Le réseau des acteurs publics"
  description="Qui décide quoi, avec quel argent, et avec qui — le réseau navigable des acteurs publics et de leurs relations, reliée à Wikipédia, Légifrance et l'open data."
  plein
  section="fonctionnement"
  sousPage="carte"
>
  <Explorateur
    reseau={reseau}
    titre="Le réseau des acteurs publics"
    etiquette="Réseau des acteurs publics et de leurs relations"
    placeholder="Chercher : eau, collège, préfet…"
    avant={'Les entreprises, les métiers et les filières ont leur carte : <a href="/economie">les rouages de l’économie</a>.'}
  />
</Base>

# Rouages.fr — configuration du serveur d'origine (o2switch, LiteSpeed/Apache).
#
# Ce fichier est copié tel quel dans dist/ par Astro et déposé à la racine du
# site. Il fait trois choses : servir les URL sans extension, dire ce qui se
# met en cache, et refuser ce qui n'a rien à faire là.

# --- Les URL n'ont pas d'extension, les fichiers en ont une ----------------
# Astro est configuré en `format: 'file'` : il écrit `n/abf.html` et pointe
# vers `/n/abf`. C'est au serveur de faire le rapprochement. MultiViews ferait
# le travail mais négocie aussi la langue et l'encodage, ce qui produit des
# surprises ; une règle explicite est plus prévisible.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une barre finale n'est jamais l'adresse canonique (`trailingSlash: never`),
  # sauf pour la racine.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Une page peut porter le nom d'un dossier : `communes.html` et `communes/`,
  # la liste des départements et celle de leurs communes. Apache ajoute alors
  # la barre finale au nom du dossier (`DirectorySlash`) avant toute
  # réécriture, et `/communes/` finissait en 403, faute d'index. On sert la
  # page à cette adresse. `DirectorySlash Off` serait plus net, mais un
  # hébergeur qui ne l'autorise pas dans un .htaccess répond 500 sur tout le
  # site.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
  RewriteCond %1.html -f
  RewriteRule ^(.+)/$ /$1.html [L]

  # /n/abf  ->  /n/abf.html, sans redirection visible.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # Une URL en .html reste valide mais n'est pas l'adresse canonique : on
  # redirige une fois pour toutes, sinon chaque page existe à deux adresses.
  # `THE_REQUEST` porte la ligne de requête d'origine, pas l'URL réécrite : la
  # règle ci-dessus ne peut donc pas la redéclencher, et il n'y a pas de boucle.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# On ne force ni HTTPS ni le domaine canonique ici : Cloudflare est devant et
# s'en charge. Le faire aussi à l'origine crée une boucle de redirection dès
# que Cloudflare est en mode SSL « flexible ».

# --- Cache ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Les fichiers de _astro/ ne portent plus d'empreinte dans leur nom : avec
  # elle, toucher une règle de CSS changeait les 35 000 pages qui la citent, et
  # toutes repartaient au serveur. Leur contenu peut donc changer sans que
  # l'URL change : le navigateur revalide à chaque visite, et reçoit un 304 de
  # quelques octets tant que rien n'a bougé.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Le HTML, lui, change à chaque publication sans changer d'adresse.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Les données territoriales changent une fois par millésime — soit une fois
  # l'an. Une heure de cache navigateur, la revalidation fait le reste.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Audit du 6 novembre 2026 (pro.rouages.fr, docs/2026-11-06-audit-securite.md).
  # Le site ne s'intègre nulle part : aucune autre origine ne peut l'afficher
  # dans un cadre, ce qui ferme le détournement de clic. `frame-ancestors` est
  # la seule directive de politique de contenu posée ici — une politique
  # complète demanderait l'empreinte de chaque script en ligne d'Astro.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Content-Security-Policy "frame-ancestors 'self'"
  # Le site ne se sert que de la position (« Là où je suis »), et seulement
  # pour lui-même.
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
  # HTTPS seulement, six mois, sans les sous-domaines : un sous-domaine qui ne
  # serait pas en HTTPS deviendrait inaccessible.
  Header set Strict-Transport-Security "max-age=15552000"
</IfModule>

# --- Compression ------------------------------------------------------------
# Les fichiers territoriaux sont du JSON très répétitif : c'est là que la
# compression rapporte le plus.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/atom+xml application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Le flux d'une commune est un document Atom, pas un XML quelconque. La plupart
# des agrégateurs s'en accommoderaient — ils reniflent la racine du document —
# mais certains refusent un type qu'ils n'attendaient pas, et le plan de site
# doit rester, lui, un `application/xml` ordinaire : d'où une règle qui ne vise
# que ces fichiers-là.
<FilesMatch "-flux\.xml$">
  ForceType application/atom+xml
</FilesMatch>

# Le HTML déclare déjà son encodage dans une balise `meta`, mais l'en-tête HTTP
# fait autorité sur elle : sans cette ligne, un serveur configuré autrement
# afficherait les accents de travers.
AddDefaultCharset utf-8

ErrorDocument 404 /404.html

# --- Ce qui n'a rien à faire sur un site statique ---------------------------
Options -Indexes

# `FilesMatch` ne voit que le nom du fichier, pas son chemin : les jetons de
# `.well-known/acme-challenge/` n'ont pas de point initial et restent servis,
# le renouvellement du certificat n'est pas cassé.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.|\.(yaml|yml|ts|json5|map)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Le site est statique : aucun PHP n'a à y être exécuté. Un fichier de
# diagnostic oublié (`test.php`, créé à la main le 30 septembre 2026 et
# découvert le 6 novembre parce qu'il affichait la version de PHP) est ainsi
# refusé même s'il reste sur le serveur.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Un refus montre la page 404 du site plutôt que celle d'Apache : il ne dit pas
# ce qui existe.
ErrorDocument 403 /404.html
